# Kopiér til .env.local og udfyld

# Lokalt: en SQLite-fil. I produktion: din Turso-database (libsql://....turso.io)
DATABASE_URL=file:./data/venskab.db
DATABASE_AUTH_TOKEN=

# Adgangskode til /admin
ADMIN_PASSWORD=skift-mig
# Lang tilfældig streng til at signere admin-login (fx: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=https://venskab.villadsclaes.dk

# Nøgle til venne-arkivets krypterede felter (AES-256-GCM, 32 byte). Kræves i produktion. Mistes den, er teksterne væk!
# Lav en med: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ARCHIVE_ENCRYPTION_KEY=

# 2FA til admin (TOTP). Tom = slået fra. Lav en med: npm run admin:totp
ADMIN_TOTP_SECRET=

# --- Valgfrit ---
# E-mail via din postkasse hos Simply.com. Uden disse sendes der bare ingen mails.
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
SMTP_USER=villadsclaes@villadsclaes.dk
SMTP_PASS=
EMAIL_FROM=Venskabsbutikken <butik@villadsclaes.dk>

# Stripe (kort, Apple Pay, Google Pay, MobilePay). Start med test-nøgler (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billedupload fra admin (Vercel → Storage → Blob). Lokalt gemmes billeder i public/uploads.
BLOB_READ_WRITE_TOKEN=

# Kalender (Google og/eller Outlook) – viser ledig/optaget og inviterer deltagere til events.
# Omdirigerings-URI'en er <NEXT_PUBLIC_SITE_URL>/api/kalender/google/callback (hhv. /outlook/callback).
# Lokalt skal NEXT_PUBLIC_SITE_URL være http://localhost:3000, for at login-rundturen virker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = både private Outlook.com-konti og arbejdskonti
MICROSOFT_TENANT=common
